# Line endings: LF everywhere (repo and checkout), on every OS.
* text=auto eol=lf

# Windows-only scripts need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.gz binary
*.zip binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary

