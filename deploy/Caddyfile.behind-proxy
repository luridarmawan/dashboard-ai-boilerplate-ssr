# Caddy WITHOUT TLS, for hosts where port 80/443 already belong to another web server (Apache/Nginx)
# that terminates HTTPS for your (sub)domain and proxies to Caddy on a loopback port. Routing is the
# same as deploy/Caddyfile; only certificates and HSTS move to the front server.
#
#   .env.prod:  CADDYFILE=./deploy/Caddyfile.behind-proxy  HTTP_PORT=127.0.0.1:8080  XFF_DEPTH=2
#   Apache:     deploy/apache.conf.example      Nginx: deploy/nginx.conf.example (proxy_pass to :8080)
{
	admin off
	auto_https off
	servers {
		# Trust X-Forwarded-* from the front server on this host / private network, so the app sees
		# https and the real client IP (rate limits, audit log, absolute links).
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	@api path /v1/* /docs /docs/* /openapi.json
	reverse_proxy @api {
		dynamic a {
			name api
			port 3001
			refresh 5s
		}
		lb_policy round_robin
		health_uri /v1/health
		health_interval 10s
	}

	reverse_proxy {
		dynamic a {
			name web
			port 3000
			refresh 5s
		}
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}
