# Reverse proxy for the single-VPS stack (PRD Decision D, E). Automatic TLS via Let's Encrypt for a
# real DOMAIN; for `localhost` Caddy issues a certificate from its internal CA. One origin: the API is
# reachable on the same host under /v1, so cookies and CORS never cross domains.
{
	email {$ACME_EMAIL}
	admin off
}

{$DOMAIN} {
	encode zstd gzip

	# Same-origin API surface. Dynamic upstreams resolve every replica of `api` (--scale api=N).
	@api path /v1/* /docs /docs/* /openapi.json
	reverse_proxy @api {
		dynamic a {
			name api
			port 3001
			refresh 5s
		}
		lb_policy round_robin
		health_uri /v1/health
		health_interval 5s
		# Rollouts (Q-12): a replica that just went away is retried on another one, transparently.
		lb_try_duration 8s
		lb_try_interval 250ms
		lb_retries 3
	}

	reverse_proxy {
		dynamic a {
			name web
			port 3000
			refresh 5s
		}
		lb_policy round_robin
		health_uri /robots.txt
		health_interval 5s
		lb_try_duration 8s
		lb_try_interval 250ms
		lb_retries 3
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}
