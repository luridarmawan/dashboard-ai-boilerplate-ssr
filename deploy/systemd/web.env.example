# /etc/crk/web.env — environment for crk-web.service.
NODE_ENV=production
# Public origin(s) form posts may come from (A-10) — the SAME list as api.env; an origin missing
# here answers 403 on theme/language/login/reset. Empty = derive it from the proxy headers below.
APP_ORIGIN=https://app.example.com
HOST=127.0.0.1
PORT=3000
API_URL=http://127.0.0.1:3001
# Behind a reverse proxy on this host: trust its headers for the client IP and the public origin.
# With ADDRESS_HEADER set the app reads the WHOLE X-Forwarded-For chain and takes the rightmost
# public entry (private NAT/proxy hops are skipped); XFF_DEPTH only steers SvelteKit's own
# getClientAddress(), which the app no longer relies on.
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host
