# /etc/dab/web.env — environment for dab-web.service.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
API_URL=http://127.0.0.1:3001
# Behind a reverse proxy on this host: trust its headers for the client IP and the public origin
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host
