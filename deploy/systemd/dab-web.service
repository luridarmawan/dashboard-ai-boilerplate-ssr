# systemd unit for the web app without Docker (PRD Q-11). Needs the `bun` runtime on the host
# (https://bun.sh/install → /usr/local/bin/bun) and dist/web from scripts/build-release.sh at /opt/dab/web.
#   sudo cp deploy/systemd/web.env.example /etc/dab/web.env   # then edit
#   sudo cp deploy/systemd/dab-web.service /etc/systemd/system/ && sudo systemctl enable --now dab-web
# Put your reverse proxy in front (deploy/nginx.conf.example or Caddy from the OS packages):
# / → 127.0.0.1:3000, /v1 /docs /openapi.json → 127.0.0.1:3001.
[Unit]
Description=Dashboard AI Boilerplate — Web (SvelteKit SSR)
After=network-online.target dab-api.service
Wants=network-online.target dab-api.service

[Service]
Type=simple
User=dab
Group=dab
EnvironmentFile=/etc/dab/web.env
WorkingDirectory=/opt/dab/web
ExecStart=/usr/local/bin/bun /opt/dab/web/index.js
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
