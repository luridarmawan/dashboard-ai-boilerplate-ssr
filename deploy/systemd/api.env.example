# /etc/dab/api.env — environment for dab-api.service (chmod 600). Same variables as compose.prod.yml's
# api service; see .env.prod.example for the meaning of each. Only bootstrap-level settings live
# here (E-6) — everything else is edited at runtime in Pengaturan.
NODE_ENV=production
API_HOST=127.0.0.1
API_PORT=3001
DB_DIALECT=mysql
DATABASE_URL=mysql://app:CHANGE-ME@127.0.0.1:3306/app
# TABLE_PREFIX=dab_
SESSION_DRIVER=database
CACHE_DRIVER=database
RATELIMIT_DRIVER=database
# REDIS_URL=redis://127.0.0.1:6379
APP_ORIGIN=https://app.example.com
UPLOADS_DIR=/var/lib/dab/uploads
LANDING_ROUTE=/example
# SMTP_HOST= SMTP_PORT=587 SMTP_USER= SMTP_PASSWORD= MAIL_FROM_ADDRESS= MAIL_FROM_NAME=
# First superadmin for `api seed`; remove after the first login
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE-ME-please-now
