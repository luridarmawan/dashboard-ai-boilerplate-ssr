# systemd unit for the API without Docker (PRD Q-11). Install:
#   sh scripts/build-release.sh && sudo cp -r dist /opt/crk
#   sudo useradd -r -s /usr/sbin/nologin crk && sudo mkdir -p /var/lib/crk/uploads && sudo chown -R crk:crk /var/lib/crk /opt/crk
#   sudo cp deploy/systemd/api.env.example /etc/crk/api.env   # then edit; chmod 600
#   sudo cp deploy/systemd/crk-api.service /etc/systemd/system/ && sudo systemctl enable --now crk-api
# Migrations stay an explicit step (Q-4): `sudo -u crk /opt/crk/api migrate` before the first start
# and after every upgrade. ExecStartPre runs `preflight` (Q-13): a half-configured host never starts.
[Unit]
Description=Dashboard AI Boilerplate — API
Documentation=https://github.com/luridarmawan/dashboard-ai-boilerplate-ssr/blob/main/docs/DEPLOY.md
After=network-online.target mysql.service mariadb.service postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=crk
Group=crk
EnvironmentFile=/etc/crk/api.env
WorkingDirectory=/opt/crk
ExecStartPre=/opt/crk/api preflight
ExecStart=/opt/crk/api serve
Restart=always
RestartSec=3
# serve() finishes in-flight requests and running jobs on SIGTERM
KillSignal=SIGTERM
TimeoutStopSec=25
LimitNOFILE=65536
# Hardening: the binary needs only its uploads directory writable
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/crk/uploads

[Install]
WantedBy=multi-user.target
