{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Elysia API — the product's source of truth; SvelteKit is its first consumer (Decision A)",
  "exports": {
    "./app": "./src/app.ts",
    "./plugins/*": "./src/plugins/*.ts",
    "./services": "./src/services.ts",
    "./mail": "./src/mail.ts",
    "./tools": "./src/tools.ts",
    "./notifications": "./src/notifications.ts",
    "./lib/*": "./src/lib/*.ts",
    "./files": "./src/files.ts",
    "./metrics": "./src/metrics.ts",
    "./webhooks": "./src/webhooks.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "bun run --cwd ../.. bootstrap >/dev/null && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@core/auth": "workspace:*",
    "@core/config": "workspace:*",
    "@core/contracts": "workspace:*",
    "@core/db": "workspace:*",
    "@core/logger": "workspace:*",
    "@core/metrics": "workspace:*",
    "@core/mail": "workspace:*",
    "@core/module-kit": "workspace:*",
    "@core/runtime": "workspace:*",
    "@core/settings": "workspace:*",
    "@core/storage": "workspace:*",
    "@core/ui-theme": "workspace:*",
    "@elysiajs/openapi": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sinclair/typebox": "^0.34.52",
    "elysia": "^1.4.0"
  }
}
