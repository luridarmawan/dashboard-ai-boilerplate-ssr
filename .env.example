# ---------------------------------------------------------------------------
# .env is ONLY for what is needed BEFORE the database can be read (PRD E-6).
# Everything else — app name, default theme, landing route, language, AI/mail
# settings — lives in the `configurations` table and is changed by an admin
# from the UI without a restart.
# ---------------------------------------------------------------------------

NODE_ENV=development

# Dialect & connection. mariadb shares the mysql schema and driver, but is tested
# as a separate CI job (PRD §4.3, P-9).
DB_DIALECT=mysql                      # mysql | mariadb | postgres
DATABASE_URL=mysql://app:app@127.0.0.1:33306/app
# DATABASE_URL=postgres://app:app@127.0.0.1:35432/app
# (ports 33306/35432 are the compose.yml defaults — chosen to avoid clashing with a
#  database already installed on the host)

# Optional: table prefix so several apps can share one database (O-2).
TABLE_PREFIX=

# Backing store for shared state. `database` is the default and MUST be correct
# under multi-instance; `redis` is an accelerator only (Decision M). `memory`
# refuses to start in production.
SESSION_DRIVER=database               # database | redis | memory
CACHE_DRIVER=database
RATELIMIT_DRIVER=database
# REDIS_URL=redis://127.0.0.1:36379

# API process port, and where SvelteKit's server reaches it (internal hop, §4.4).
API_HOST=127.0.0.1                    # 0.0.0.0 inside containers
API_PORT=3001
API_URL=http://127.0.0.1:3001

# Upload storage root (Q-9); a mapped volume in production.
UPLOADS_DIR=./data/uploads

# Scheduler (G-18): every API instance runs one; the database lease guarantees a job runs
# once per interval across instances. Set false for one-off scripts. INSTANCE_ID defaults
# to hostname:pid.
SCHEDULER_ENABLED=true
# INSTANCE_ID=api-1

# Auth (FR-A). SIGNUP_ENABLED defaults to true outside production. APP_ORIGIN is the public
# origin behind the proxy (used by the CSRF Origin check). LOGIN_RATE_LIMIT = <limit>/<seconds>.
SIGNUP_ENABLED=true
SESSION_TTL_HOURS=720
# APP_ORIGIN=https://app.example.com
LOGIN_RATE_LIMIT=10/900
# First superadmin, read only by `bun db:seed` (C-5). Remove after the first seed.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=change-me-please

# Bootstrap fallback only — the real value lives in database configuration (§4.7).
LANDING_ROUTE=/m/example


# Demo mode (E-7): refuse every write with a clear message. Everything else an admin may change
# lives in the database configuration UI (E-6) — never add runtime settings to this file.
# DEMO_MODE=false
