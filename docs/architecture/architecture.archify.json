  "cards": [
    {
      "dot": "cyan",
      "title": "Edge & SSR",
      "items": [
        "One origin: /v1 and pages share a single domain",
        "Full HTML — session, permissions, theme, locale in the first byte",
        "Unknown URLs are trapped and handed to a module's 404 page (app.not_found_route)",
        "One x-request-id spans web → API → log"
      ]
    },
    {
      "dot": "emerald",
      "title": "API core & modules",
      "items": [
        "OpenAPI from route schemas; disabled modules are hidden per tenant",
        "One gate: session, effective permissions, CSRF, tenant",
        "/v1/mcp is a thin shell over the same tool registry — bearer tokens, every call audited",
        "Google sign-in is optional: linked by Google sub, MFA still enforced"
      ]
    },
    {
      "dot": "violet",
      "title": "Data & work",
      "items": [
        "One descriptor → MySQL, MariaDB, PostgreSQL; SQLite as the tier-2 dialect",
        "Jobs claimed by one conditional UPDATE: exactly once at any scale",
        "Mail outbox with open/click tracking, HMAC webhooks, files to a volume or S3",
        "Prometheus scrapes /metrics at the API root; Grafana & Alertmanager ship in compose.prod.yml"
      ]
    }
  ]
