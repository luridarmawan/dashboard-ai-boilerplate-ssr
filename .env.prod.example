# Production environment for compose.prod.yml. Copy to .env.prod and edit. Only bootstrap-level
# settings live here (PRD E-6); everything an admin may change at runtime is in the database.

DOMAIN=example.com                 # localhost → Caddy uses its internal CA (dev/test)
ACME_EMAIL=ops@example.com         # only used by deploy/Caddyfile (Caddy does TLS); unused behind a front proxy
HTTP_PORT=80
HTTPS_PORT=443

# Port 80/443 already taken by Apache/Nginx on this host? Let that server terminate TLS for the
# (sub)domain and proxy to Caddy on a loopback port (DEPLOY.md §2b, deploy/apache.conf.example):
# CADDYFILE=./deploy/Caddyfile.behind-proxy
# HTTP_PORT=127.0.0.1:8080
# HTTPS_PORT=127.0.0.1:8443          # unused in this mode, kept off the public interface
# XFF_DEPTH=2                        # client IP is 2 hops back (front server → Caddy → web)
# APP_ORIGIN: every public origin this installation answers on, comma-separated. Form posts / login
# are accepted only from these (CSRF). A bare host means http AND https; the first https entry is
# used for links in emails. Default: https://DOMAIN. Example for several (sub)domains + local tests:
# APP_ORIGIN=https://apps.carik.id,https://xxx.domain.com,localhost,http://localhost:8080

DB_DIALECT=mysql
DATABASE_NAME=app                  # name of the database inside the mysql service (created on first start)
# TABLE_PREFIX=dab_                # optional (O-2): prefix for every table when several apps share one database; set BEFORE the first migrate
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-app
# DATABASE_URL is derived from MYSQL_PASSWORD + DATABASE_NAME by default; set it explicitly for an external DB:
# DATABASE_URL=mysql://app:change-me-app@mysql:3306/app_boilerplate

SESSION_DRIVER=database
CACHE_DRIVER=database
RATELIMIT_DRIVER=database
# REDIS_URL=redis://valkey:6379      # with `--profile redis`

# Backups (Q-8): daily logical dumps into BACKUP_HOST_DIR, pruned after BACKUP_KEEP_DAYS.
# Passwords must stay URL-safe (no @ : / ? #) because DATABASE_URL is parsed by deploy/db-env.sh.
BACKUP_HOST_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
# BACKUP_IMAGE=postgres:16          # when DB_DIALECT=postgres

# Bootstrap fallback for the landing page at `/`; an admin's value in Pengaturan wins (§4.7).
LANDING_ROUTE=/example

# Branding of this deployment (§4.7). Copy that must be right in the very first HTML, before any
# database is read: the landing page headline, the line under it, and the footer of every page.
# APP_LANDING_TITLE also titles the OpenAPI document at /docs. Unset = the translated defaults.
# The sign-in footer already prints "©" before APP_FOOTER_TITLE, so leave it out of the value.
# APP_LANDING_TITLE=Dashboard AI Boilerplate
# APP_LANDING_LEAD=API-first, multi-tenant, bertema.
# APP_FOOTER_TITLE=Dashboard AI Boilerplate

# Uploads (Q-16). Default: the `uploads` Docker volume (local adapter). For an S3-compatible bucket
# (AWS S3, MinIO, Cloudflare R2, DigitalOcean Spaces …) switch the driver and fill the S3_* values:
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com   # MinIO: http://minio:9000, R2: https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=dab-uploads
# S3_REGION=ap-southeast-1                              # `auto` for R2/MinIO
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://cdn.example.com                 # optional: public files link straight to the bucket/CDN instead of via the API
# S3_VIRTUAL_HOSTED_STYLE=false                         # true only for providers that reject path-style URLs

# Email (J-1). Fill these to send real mail from the first deploy; an admin can still change them in
# Pengaturan → Email (a filled setting wins over .env, field by field). Without SMTP in production,
# emails stay queued in the outbox (/v1/outbox) — verification / reset links are never lost.
# Test before `dc up -d`: `bun --env-file=.env.prod run mail:test --to you@example.com`.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587                     # 587 = STARTTLS (default), 465 = implicit TLS
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=change-me
# SMTP_SECURE=false                 # only needed to force TLS mode when the port rule is wrong
# MAIL_FROM_ADDRESS=noreply@example.com
# MAIL_FROM_NAME=Nama Aplikasi
IMAGE_PREFIX=dab                   # CD (Q-15): ghcr.io/<owner>/<repo> (huruf kecil) agar `deploy/upgrade.sh --pull <tag>` menarik image dari registry
IMAGE_TAG=local                    # deploy/upgrade.sh rewrites this to the git commit it deployed — keep it in sync with the running stack

# Metrics (M-6). `GET /metrics` on the api port (3001, inside the Docker network — Caddy does not
# proxy it). Run Prometheus alongside: `dc --profile monitoring up -d` (deploy/prometheus.yml,
# UI on 127.0.0.1:9090). Set a token when the api port is reachable beyond the stack network:
# METRICS_TOKEN=a-long-random-string-at-least-16-chars   # then put it in deploy/prometheus.yml too
# METRICS_ENABLED=true
# PROMETHEUS_RETENTION=15d
# GRAFANA_ADMIN_PASSWORD=change-me-please-now   # Grafana (same profile) at 127.0.0.1:3300, dashboard "Dashboard AI Boilerplate — API" provisioned
# ALERTMANAGER_CONFIG=./deploy/alertmanager.local.yml   # your filled-in copy of deploy/alertmanager.yml (email/Slack/Telegram); default ships receivers commented out

# Resource caps per service (Q-14). Defaults fit 2 vCPU / 4 GB with 3 api replicas (§8 #25); raise on bigger hosts.
# API_MEM_LIMIT=384m   API_CPUS=1.0        (per replica)
# WEB_MEM_LIMIT=384m   WEB_CPUS=1.0
# MYSQL_MEM_LIMIT=1024m MYSQL_CPUS=1.5
# CADDY_MEM_LIMIT=128m BACKUP_MEM_LIMIT=256m VALKEY_MEM_LIMIT=256m

# AI (H-2): bootstrap for Pengaturan → AI (same field-by-field fallback as Email/Google, E-6).
# Fill to wire a default provider from the first deploy; an admin can still override
# per tenant in Pengaturan → AI. Without either, chat is refused with no_api_key (H-4).
# AI_API_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=

# First superadmin, created once by `run --rm seed` (O-3). Remove after the first deploy if you like.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-please-now
