{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/generated", "!**/migrations", "!**/node_modules", "!modules/Hello"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "noNonNullAssertion": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/test/**", "**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.svelte"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["**/src/app.html"],
      "linter": {
        "rules": {
          "a11y": {
            "useValidLang": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/domains/**", "modules/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@core/db": {
                    "importNames": ["getDb"],
                    "message": "Domain code must not take the raw connection: use forTenant(clientId) for tenant tables, or unsafeAcrossTenants() \u2014 explicit and greppable (PRD B-3)."
                  },
                  "drizzle-orm": "Import query operators from @core/db, not drizzle-orm (one ORM version; Kysely fallback stays open, PRD \u00a710)."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/**", "modules/**/web/**", "!apps/web/src/lib/icons/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@lucide/svelte": "Components never import glyphs (PRD L-5): use <Icon name=\"\u2026\" /> \u2014 the active theme's icon set decides the glyph.",
                  "phosphor-svelte": "Components never import glyphs (PRD L-5): use <Icon name=\"\u2026\" /> \u2014 the active theme's icon set decides the glyph."
                }
              }
            }
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
