{
  "name": "@core/auth",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Identity primitives shared by the API: permission matching (C-1, C-2), the resource registry (C-4), password & token helpers",
  "exports": {
    ".": "./src/index.ts",
    "./seed-all": "./src/seed-all.ts"
  },
  "scripts": {
    "seed": "bun --env-file=../../.env run scripts/seed.ts",
    "typecheck": "bun run --cwd ../.. bootstrap >/dev/null && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@core/config": "workspace:*",
    "@core/db": "workspace:*",
    "@core/logger": "workspace:*",
    "@core/module-kit": "workspace:*"
  }
}
